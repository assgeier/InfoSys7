digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Создать заказ сотрудника в статусе DRAFT"];
n2 [label="Получить товар и количество", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n3 [label="Проверить товар: id и название не пустые, цена больше 0;\nпроверить количество: от 1 до 10"];
n4 [label="Позиция корректна", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5 [label="Товар уже есть в заказе", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5a [label="Название и цена совпадают\nс уже добавленными", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5b [label="Сумма количеств по товару\nне больше 10", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Увеличить количество существующей позиции"];
n6b [label="Добавить новую позицию"];
err [label="Отклонить позицию с сообщением об ошибке,\nсостав заказа не меняется", fillcolor="#F8D7DA", color="#C00000"];
n7 [label="Есть ещё позиции", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n8 [label="Рассчитать итог как сумму\nцена × количество по всем позициям"];
n9a [label="Заказ в статусе DRAFT\nи содержит хотя бы одну позицию", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n9 [label="Перевести заказ в статус CONFIRMED,\nдальнейшие изменения запрещены"];
err2 [label="Отказать в подтверждении", fillcolor="#F8D7DA", color="#C00000"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5 [label="да"];
n4 -> err [label="нет"];
n5 -> n5a [label="да"];
n5 -> n6b [label="нет"];
n5a -> n5b [label="да"];
n5a -> err [label="нет"];
n5b -> n6 [label="да"];
n5b -> err [label="нет"];
err -> n7;
n6 -> n7;
n6b -> n7;
n7 -> n2 [label="да"];
n7 -> n8 [label="нет"];
n8 -> n9a;
n9a -> n9 [label="да"];
n9a -> err2 [label="нет"];
n9 -> end;
err2 -> end;
}
